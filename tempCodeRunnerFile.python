    fig_sinr_comparison()
    fig_avg_data_rate()
    fig_cdf_data_rate()
    fig_system_architecture()
    fig_relay_architecture()
    fig_ddqn_architecture()
    fig_epsilon_decay()
    fig_mdp()
    print('\n[✓] All figures generated successfully.')